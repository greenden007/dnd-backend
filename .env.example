# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB Connection
MONGODB_URI=mongodb://mongodb:27017/dnd-characters

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# CORS Configuration
CORS_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Email Configuration (for password reset, notifications, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465, false for other ports
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM='"D&D Character Sheet" <noreply@yourdomain.com>'

# Logging
LOG_LEVEL=info  # error, warn, info, debug
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# API Documentation
API_DOCS_PATH=/api-docs

# Security
TRUST_PROXY=1  # Set to 1 to trust proxy headers (e.g., when behind Nginx)
REQUEST_BODY_LIMIT=10mb  # Limit request body size

# Feature Flags
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_LOGGING=true

# Development Only
DEBUG=app:*,api:*,db:*
NODE_OPTIONS=--max_old_space_size=4096
